14:textId="68FB6D94" w:rsidR="009A0E28" w:rsidRDefault="009A0E28" w:rsidP="007D06AC"><w:r w:rsidRPr="009A0E28"><w:t>Nuestros departamento técnico de obras puede tramitarte dicho documento con la ART garantizándote la aprobación y asesorándote para el ingreso o para cumplir la normativa de seguridad en la construcción.</w:t></w:r></w:p><w:p w14:paraId="6A8BBF5A" w14:textId="0F2AC6FC" w:rsidR="009A0E28" w:rsidRDefault="009A0E28" w:rsidP="007D06AC"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="007D06AC"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Medición de Contaminantes</w:t></w:r></w:p><w:p w14:paraId="321AF9FB" w14:textId="536E0409" w:rsidR="009A0E28" w:rsidRDefault="009A0E28" w:rsidP="007D06AC"><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Capacitaciones</w:t></w:r></w:p><w:p w14:paraId="340F8D77" w14:textId="77777777" w:rsidR="009A0E28" w:rsidRPr="007D06AC" w:rsidRDefault="009A0E28" w:rsidP="007D06AC"/><w:p w14:paraId="51297FD0" w14:textId="0A2704A5" w:rsidR="007D06AC" w:rsidRDefault="007D06AC"><w:hyperlink r:id="rId11" w:history="1"><w:r w:rsidRPr="00280B59"><w:rPr><w:rStyle w:val="Hipervnculo"/></w:rPr><w:t>https://cydconsultores.com.ar/medio-ambiente/</w:t></w:r></w:hyperlink></w:p><w:p w14:paraId="1080FFDD" w14:textId="77777777" w:rsidR="007D06AC" w:rsidRDefault="007D06AC"/><w:p w14:paraId="72B63F18" w14:textId="2C753F42" w:rsidR="00032F13" w:rsidRPr="00032F13" w:rsidRDefault="00032F13"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00032F13"><w:rPr><w:b/><w:bCs/><w:highlight w:val="yellow"/></w:rPr><w:t>INSPECCIONES</w:t></w:r></w:p><w:p w14:paraId="461AB3A2" w14:textId="77777777" w:rsidR="00032F13" w:rsidRDefault="00032F13"/><w:p w14:paraId="49626D11" w14:textId="02A38CF9" w:rsidR="007D06AC" w:rsidRDefault="009A0E28"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:hyperlink r:id="rId12" w:history="1"><w:r w:rsidRPr="00280B59"><w:rPr><w:rStyle w:val="Hipervnculo"/><w:b/><w:bCs/></w:rPr><w:t>https://preven.com.ar/inspecciones.html</w:t></w:r></w:hype